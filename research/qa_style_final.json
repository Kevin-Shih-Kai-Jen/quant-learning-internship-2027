    {
      "para_index": 2,
      "text": "\u6a5f\u5668\u4eba\u8207\u81ea\u52d5\u5316\u80a1\u7968\u7814\u7a76\u4f01\u5283\u66f8",
      "style": "Title"
    },
    {
      "para_index": 57,
      "text": "\u95dc\u53611\uff1a\u73fe\u5728\u9760\u4ec0\u9ebc\u8cfa\u9322\uff1a\u5148\u7406\u89e3\u65e2\u6709\u7522\u54c1\u3001\u5ba2\u6236\u3001\u6bdb\u5229\u8207\u73fe\u91d1\u6d41\uff0c\u907f\u514d\u53ea\u7814\u7a76\u65b0\u6545\u4e8b\u3002",
      "style": "Normal"
    },
    {
      "para_index": 58,
      "text": "\u95dc\u53612\uff1a\u672a\u4f86\u56db\u5b63\u5982\u4f55\u6210\u9577\uff1a\u50ac\u5316\u5291\u5fc5\u9808\u80fd\u5beb\u6210\u51fa\u8ca8\u3001ASP\u3001\u7522\u80fd\u5229\u7528\u7387\u3001\u7522\u54c1\u7d44\u5408\u6216\u8cbb\u7528\u7387\u7684\u8b8a\u5316\u3002",
      "style": "Normal"
    },
    {
      "para_index": 59,
      "text": "\u95dc\u53613\uff1a\u6210\u9577\u80fd\u5426\u6301\u7e8c\uff1a\u6aa2\u67e5\u5ba2\u6236\u9a57\u8b49\u3001\u5207\u63db\u6210\u672c\u3001\u53ef\u9760\u5ea6\u3001\u552e\u5f8c\u670d\u52d9\u548c\u8edf\u786c\u9ad4\u6574\u5408\u3002",
      "style": "Normal"
    },
    {
      "para_index": 60,
      "text": "\u95dc\u53614\uff1a\u5e02\u5834\u5df2\u7d93\u671f\u5f85\u591a\u5c11\uff1a\u7528\u53cd\u63a8EPS\u8207\u53cd\u63a8\u71df\u6536\u5224\u65b7\u80a1\u50f9\u662f\u5426\u5df2\u7d93\u5305\u542b\u6a02\u89c0\u60c5\u5883\u3002",
      "style": "Normal"
    },
    {
      "para_index": 61,
      "text": "\u95dc\u53615\uff1a\u932f\u4e86\u5982\u4f55\u9000\u51fa\uff1a\u9810\u5148\u5beb\u4e0b\u50f9\u683c\u505c\u640d\u3001\u57fa\u672c\u9762\u505c\u640d\u3001\u6aa2\u67e5\u65e5\u671f\u8207\u6700\u5927\u90e8\u4f4d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 180,
      "text": "\u6a5f\u7387\u52a0\u6b0a\u76ee\u6a19\u50f9 = \u60b2\u89c0\u76ee\u6a19\u50f9 \u00d7 \u60b2\u89c0\u6a5f\u7387 + \u57fa\u6e96\u76ee\u6a19\u50f9 \u00d7 \u57fa\u6e96\u6a5f\u7387 + \u6a02\u89c0\u76ee\u6a19\u50f9 \u00d7 \u6a02\u89c0\u6a5f\u7387\u3002",
      "style": "Normal"
    },
    {
      "para_index": 186,
      "text": "[S1] \u76f4\u5f97\u79d1\u6280\u5b98\u65b9\u7522\u54c1\u8207\u516c\u53f8\u7db2\u7ad9 - https://chieftek.com/zh-hant/",
      "style": "Source Text"
    },
    {
      "para_index": 187,
      "text": "[S2] \u5927\u9280\u5fae\u7cfb\u7d71\u5b98\u65b9\u7522\u54c1\u8207\u6295\u8cc7\u4eba\u7db2\u7ad9 - https://www.hiwinmikro.tw/zh",
      "style": "Source Text"
    },
    {
      "para_index": 188,
      "text": "[S3] \u6ce2\u82e5\u5a01\u5b98\u65b9\u516c\u53f8\u6982\u6cc1 - https://www.browave.com/investors/Category/20",
      "style": "Source Text"
    },
    {
      "para_index": 190,
      "text": "[S5] \u76f4\u5f972026\u5e748\u670824\u65e5\u5e02\u5834\u8207\u8fd1\u56db\u5b63\u8ca1\u52d9\u5feb\u7167 - https://info.ifa.ai/tw-stock/1597",
      "style": "Source Text"
    },
    {
